# Firebase (obligatoire) — copie ce fichier en `.env`
EXPO_PUBLIC_FIREBASE_API_KEY=ta_cle_api
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=ton-projet.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=ton-projet
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=ton-projet.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=ton_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=ton_app_id

# EAS project id (pour les notifications push distantes) — ex: obtenu via `eas init`
EXPO_PUBLIC_EAS_PROJECT_ID=
